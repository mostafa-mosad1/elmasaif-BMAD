datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  BUYER
  MARKETER
  OWNER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  FINANCIAL_AUDITOR
  COMPLIANCE_OFFICER
}

enum ProfileStatus {
  ACTIVE
  UNDER_REVIEW
  SUSPENDED
  COMPLIANCE_RESTRICTED
  DELETION_PENDING
  DEACTIVATED
  DISABLED
  SOFT_DELETED
}

enum PropertyType {
  VILLA
  LAND
  APARTMENT
  BUILDING
  COMMERCIAL
  FARM
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_FEE
  ACTIVE
  RESERVED
  SOLD
  REJECTED
  UNDER_COMPLIANCE_REVIEW
  ARCHIVED
  SUSPENDED
  BLOCKED
}

enum OfferStatus {
  PENDING_ADMIN_REVIEW
  SUBMITTED
  IN_REVIEW
  RELAYED_TO_SELLER
  ACCEPTED_BY_SELLER
  REJECTED_BY_SELLER
  COUNTER_OFFERED
  ACCEPTED_BY_BUYER
  EXPIRED
  WITHDRAWN
  RELAYED_TO_BUYER
  REJECTED_BY_ADMIN
  SELECTED_PENDING_FINAL_ADMIN_APPROVAL
  CLOSED_BACKUP
  /// Story 5.1: the approved offer was bound to a Deal and is now terminal.
  CONVERTED_TO_DEAL
}

enum DealStatus {
  AWAITING_PAYMENT_PROOF
  UNDER_ADMIN_AUDIT
  PAYMENT_REJECTED
  COMPLETED
  CANCELLED
  TERMINATED
}

enum PaymentType {
  PLATFORM_COMMISSION
  SELLER_PURCHASE_PRICE
  OWNER_CONTRACT_FEE
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DemandStatus {
  ACTIVE
  MATCHED
  EXPIRED
  CANCELLED
  CLOSED
}

enum ProposalStatus {
  PENDING_ADMIN_REVIEW
  APPROVED_FOR_BUYER
  REJECTED
  SELECTED_PENDING_FINAL_ADMIN_APPROVAL
  CLOSED
}

enum OwnerContractStatus {
  DRAFT
  PENDING_SIGNATURE
  PENDING_FEE
  ACTIVE
  EXPIRED
  TERMINATED
}

enum DocumentVisibility {
  PUBLIC
  ADMIN_ONLY
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SCAN_FAILED
}

enum IdentityDocumentType {
  NATIONAL_ID
  IQAMA
}

enum VerificationStatus {
  NOT_UPLOADED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum PriceSuggestionStatus {
  PENDING
  ACCEPTED
  DECLINED
  SUPERSEDED
}

/// Story 4.4 / FR-35: the mediated conversation funnel. CLOSED is terminal and reachable from
/// every non-terminal state.
enum InquiryStatus {
  PENDING_ADMIN_REVIEW
  RELAYED_TO_SELLER
  SELLER_RESPONDED
  RELAYED_TO_BUYER
  CLOSED
}

enum InquiryAuthorRole {
  BUYER
  SELLER
  ADMIN
}

model User {
  id                  String        @id @default(uuid())
  username            String        @unique
  fullName            String
  mobileNumber        String        @unique
  nationalId          String        @unique
  passwordHash        String
  status              ProfileStatus @default(ACTIVE)
  email               String?       @unique
  pendingEmail        String?
  emailVerifiedAt     DateTime?
  deletionRequestedAt DateTime?
  deletionDueAt       DateTime?
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  profiles            UserProfile[]
  sessions            Session[]
  consentRecords      ConsentRecord[]
  phoneChangeRequests PhoneChangeRequest[]
  authoredRatings     Rating[]             @relation("AuthoredRatings")
  receivedRatings     Rating[]             @relation("ReceivedRatings")
  knownDevices        KnownDevice[]
  identityDocuments   IdentityDocument[]
  preferences         UserPreference?
  favorites           ListingFavorite[]

  @@map("users")
}

model ConsentRecord {
  id               String   @id @default(uuid())
  userId           String
  termsVersion     String
  privacyVersion   String
  consentTimestamp DateTime
  ipAddress        String
  userAgent        String
  source           String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consent_records")
}

model PhoneChangeRequest {
  id                String   @id @default(uuid())
  userId            String
  oldPhoneNumber    String
  newPhoneNumber    String
  oldPhoneOtp       String?
  newPhoneOtp       String?
  oldVerified       Boolean  @default(false)
  newVerified       Boolean  @default(false)
  isSupportAssisted Boolean  @default(false)
  supportReason     String?
  adminId           String?
  expiresAt         DateTime
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("phone_change_requests")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  preferredLanguage  String   @default("ar") @map("preferred_language")
  themeMode          String   @default("light") @map("theme_mode")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  smsNotifications   Boolean  @default(true) @map("sms_notifications")
  marketingAlerts    Boolean  @default(false) @map("marketing_alerts")
  inquiryAlerts      Boolean  @default(true) @map("inquiry_alerts")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserProfile {
  id         String        @id @default(uuid())
  userId     String
  role       UserRole
  status     ProfileStatus @default(ACTIVE)
  payoutIban String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  falLicense           FalLicense?
  payoutAccounts       PayoutAccount[]
  listings             Listing[]             @relation("ProfileListings")
  buyerOffers          Offer[]               @relation("BuyerOffers")
  buyerDeals           Deal[]                @relation("BuyerDeals")
  sellerDeals          Deal[]                @relation("SellerDeals")
  demands              Demand[]
  demandMatches        DemandMatch[]         @relation("ProviderDemandMatches")
  proposals            Proposal[]            @relation("ProviderProposals")
  contracts            OwnerContract[]
  ownerListingRequests OwnerListingRequest[]
  buyerInquiries       ListingInquiry[]      @relation("BuyerInquiries")
  sellerInquiries      ListingInquiry[]      @relation("SellerInquiries")

  @@unique([userId, role])
  @@map("user_profiles")
}

model FalLicense {
  id              String        @id @default(uuid())
  profileId       String        @unique
  licenseNumber   String        @unique
  certificateUrl  String
  expiryDate      DateTime
  commercialName  String?
  crNumber        String?
  status          ProfileStatus @default(UNDER_REVIEW)
  lockedByAdminId String?
  lockedAt        DateTime?
  lockExpiresAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([lockExpiresAt])
  @@map("fal_licenses")
}

model PayoutAccount {
  id                        String   @id @default(uuid())
  profileId                 String   @map("profile_id")
  accountHolderName         String   @map("account_holder_name")
  bankName                  String?  @map("bank_name")
  ibanEncrypted             String   @map("iban_encrypted")
  ibanMasked                String   @map("iban_masked")
  ibanLast4                 String   @map("iban_last4")
  isDefault                 Boolean  @default(true) @map("is_default")
  hasCommercialNameMismatch Boolean  @default(false) @map("has_commercial_name_mismatch")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("payout_accounts")
}

model AdminUser {
  id                     String    @id @default(uuid())
  username               String    @unique
  email                  String    @unique
  fullName               String
  passwordHash           String
  role                   AdminRole @default(MODERATOR)
  isActive               Boolean   @default(true)
  lastLoginAt            DateTime?
  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime? @map("locked_until")
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sessions AdminSession[]

  @@map("admin_users")
}

model City {
  id        String   @id @default(uuid())
  nameAr    String
  nameEn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  districts District[]
  listings  Listing[]
  demands   Demand[]

  @@map("cities")
}

model District {
  id        String   @id @default(uuid())
  cityId    String
  nameAr    String
  nameEn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  city     City      @relation(fields: [cityId], references: [id])
  listings Listing[]
  demands  Demand[]

  @@unique([id, cityId])
  @@map("districts")
}

model Listing {
  id                  String        @id @default(uuid())
  title               String
  description         String
  propertyType        PropertyType
  cityId              String
  districtId          String
  streetName          String?
  latitude            Float
  longitude           Float
  askPrice            Decimal       @db.Decimal(12, 2)
  areaSquareMeters    Float
  bedrooms            Int?
  yearBuilt           Int?
  status              ListingStatus @default(DRAFT)
  sellerProfileId     String
  payoutIban          String
  version             Int           @default(1)
  lockedByAdminId     String?
  lockedAt            DateTime?
  lockExpiresAt       DateTime?
  rejectionReason     String?       @map("rejection_reason")
  reviewedByAdminId   String?       @map("reviewed_by_admin_id")
  reviewedAt          DateTime?     @map("reviewed_at")
  complianceReason    String?       @map("compliance_reason")
  complianceCategory  String?       @map("compliance_category")
  complianceActionAt  DateTime?     @map("compliance_action_at")
  complianceOfficerId String?       @map("compliance_officer_id")
  archivedAt          DateTime?     @map("archived_at")
  archiveReason       String?       @map("archive_reason")
  totalViews          Int           @default(0) @map("total_views")
  totalImpressions    Int           @default(0) @map("total_impressions")
  totalFavorites      Int           @default(0) @map("total_favorites")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  city             City                 @relation(fields: [cityId], references: [id])
  district         District             @relation(fields: [districtId, cityId], references: [id, cityId])
  sellerProfile    UserProfile          @relation("ProfileListings", fields: [sellerProfileId], references: [id])
  documents        PropertyDocument[]
  priceSuggestions PriceSuggestion[]
  offers           Offer[]
  deals            Deal[]
  ownerContract    OwnerContract?
  dailyMetrics     ListingDailyMetric[]
  favorites        ListingFavorite[]
  demandMatches    DemandMatch[] @relation("DemandMatchListing")
  proposals        Proposal[]    @relation("ProposalListing")
  inquiries        ListingInquiry[] @relation("InquiryListing")

  @@index([status, propertyType, cityId, districtId])
  @@index([status, createdAt])
  @@index([status, askPrice])
  @@index([status, latitude, longitude])
  @@index([lockExpiresAt])
  @@map("listings")
}

model ListingDailyMetric {
  id           String   @id @default(uuid())
  listingId    String   @map("listing_id")
  date         DateTime @db.Date
  impressions  Int      @default(0)
  detailViews  Int      @default(0) @map("detail_views")
  favoriteAdds Int      @default(0) @map("favorite_adds")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([date])
  @@map("listing_daily_metrics")
}

model ListingFavorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("listing_favorites")
}

model PriceSuggestion {
  id                   String                @id @default(uuid())
  listingId            String                @map("listing_id")
  currentAskPrice      Decimal               @map("current_ask_price") @db.Decimal(12, 2)
  suggestedPrice       Decimal               @map("suggested_price") @db.Decimal(12, 2)
  reason               String
  status               PriceSuggestionStatus @default(PENDING)
  suggestedByAdminId   String                @map("suggested_by_admin_id")
  suggestedByAdminName String                @map("suggested_by_admin_name")
  sellerResponseNote   String?               @map("seller_response_note")
  respondedAt          DateTime?             @map("responded_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@map("price_suggestions")
}

model PropertyDocument {
  id           String             @id @default(uuid())
  listingId    String
  documentType String
  fileUrl      String
  mimeType     String
  fileSize     Int
  scanStatus   ScanStatus         @default(PENDING)
  scannedAt    DateTime?
  visibility   DocumentVisibility @default(ADMIN_ONLY)
  createdAt    DateTime           @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([scanStatus])
  @@map("property_documents")
}

model FileObject {
  id               String            @id @default(uuid())
  bucket           String
  key              String            @unique
  mimeType         String
  fileSize         Int
  scanStatus       ScanStatus        @default(PENDING)
  scannedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  identityDocument IdentityDocument?

  @@index([scanStatus])
  @@map("file_objects")
}

model IdentityDocument {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  fileObjectId      String               @unique @map("file_object_id")
  documentType      IdentityDocumentType @map("document_type")
  idNumber          String               @map("id_number")
  status            VerificationStatus   @default(PENDING_REVIEW)
  verifiedAt        DateTime?            @map("verified_at")
  verifiedByAdminId String?              @map("verified_by_admin_id")
  rejectionReason   String?              @map("rejection_reason")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileObject FileObject @relation(fields: [fileObjectId], references: [id])

  @@index([userId, status])
  @@index([status])
  @@map("identity_documents")
}

model Offer {
  id              String      @id @default(uuid())
  listingId       String
  buyerProfileId  String
  offerPrice      Decimal     @db.Decimal(12, 2)
  status          OfferStatus @default(PENDING_ADMIN_REVIEW)
  isBackup        Boolean     @default(false) @map("is_backup")
  isLowPrice      Boolean     @default(false) @map("is_low_price")
  note            String?
  version         Int         @default(1)
  lockedByAdminId String?
  lockedAt        DateTime?
  lockExpiresAt   DateTime?
  expiresAt       DateTime
  negotiationRound Int        @default(0) @map("negotiation_round")
  rejectionReason String?     @map("rejection_reason")
  rejectionNote   String?     @map("rejection_note")
  activatedAt     DateTime?   @map("activated_at")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  listing      Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerProfile UserProfile    @relation("BuyerOffers", fields: [buyerProfileId], references: [id])
  history      OfferHistory[]

  @@index([listingId, status])
  @@index([listingId, buyerProfileId, status])
  @@index([listingId, isBackup, status])
  @@index([lockExpiresAt])
  @@index([status, expiresAt])
  @@map("offers")
}

model OfferHistory {
  id             String   @id @default(uuid())
  offerId        String
  actorProfileId String?
  actorAdminId   String?  @map("actor_admin_id")
  action         String
  priceSnapshot  Decimal? @db.Decimal(12, 2)
  notes          String?
  roundNumber    Int?     @map("round_number")
  createdAt      DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  @@index([offerId, createdAt])
  @@map("offer_history")
}

/// Story 4.4 / FR-35, FR-51: a listing-scoped, admin-mediated inquiry thread. Deliberately a new
/// entity rather than an extension of the pre-deal `Conversation` placeholder (D1).
model ListingInquiry {
  id               String        @id @default(uuid())
  listingId        String        @map("listing_id")
  buyerProfileId   String        @map("buyer_profile_id")
  sellerProfileId  String        @map("seller_profile_id")
  status           InquiryStatus @default(PENDING_ADMIN_REVIEW)
  subject          String?
  version          Int           @default(1)
  lockedByAdminId  String?       @map("locked_by_admin_id")
  lockedAt         DateTime?     @map("locked_at")
  lockExpiresAt    DateTime?     @map("lock_expires_at")
  lastMessageAt    DateTime      @map("last_message_at")
  closedAt         DateTime?     @map("closed_at")
  closedByAdminId  String?       @map("closed_by_admin_id")
  closeReason      String?       @map("close_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  listing       Listing          @relation("InquiryListing", fields: [listingId], references: [id], onDelete: Cascade)
  buyerProfile  UserProfile      @relation("BuyerInquiries", fields: [buyerProfileId], references: [id])
  sellerProfile UserProfile      @relation("SellerInquiries", fields: [sellerProfileId], references: [id])
  messages      InquiryMessage[]

  @@index([status, createdAt])
  @@index([listingId, buyerProfileId, status])
  @@index([lockExpiresAt])
  @@map("listing_inquiries")
}

/// One relayed message. `relayedAt` is what makes the buyer↔seller block enforceable: a message
/// the platform has not relayed stays invisible to the counterparty (AC-4).
model InquiryMessage {
  id               String            @id @default(uuid())
  inquiryId        String            @map("inquiry_id")
  authorRole       InquiryAuthorRole @map("author_role")
  authorProfileId  String?           @map("author_profile_id")
  authorAdminId    String?           @map("author_admin_id")
  body             String
  maskingApplied   Boolean           @default(false) @map("masking_applied")
  maskedTypes      String?           @map("masked_types")
  relayedAt        DateTime?         @map("relayed_at")
  relayedByAdminId String?           @map("relayed_by_admin_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  inquiry     ListingInquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  attachments InquiryAttachment[]

  @@index([inquiryId, createdAt])
  @@map("inquiry_messages")
}

/// A scanned attachment. `messageId = null` means the draft was uploaded but never linked to a
/// message, so it is invisible everywhere (AC-2, D7).
model InquiryAttachment {
  id                  String   @id @default(uuid())
  fileObjectId        String   @unique @map("file_object_id")
  uploadedByProfileId String   @map("uploaded_by_profile_id")
  messageId           String?  @map("message_id")
  fileName            String   @map("file_name")
  mimeType            String   @map("mime_type")
  fileSize            Int      @map("file_size")
  createdAt           DateTime @default(now()) @map("created_at")

  message InquiryMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("inquiry_attachments")
}

/// FR-29 frozen financial snapshot (Story 5.1 / AD-3). Column-name mapping (D1): `dealPrice` =
/// FinalDealPrice, `platformCommission` = FinalCommission, `totalAmount` = FinalTotal. The names
/// are kept as-is because `prisma db push` cannot rename a column without dropping it and losing
/// its data; `DealBinding` carries the mapping to the API contract.
///
/// AD-4 / BR-07: at most one *non-terminal* deal per listing. That invariant is a partial unique
/// index (`deal_single_active_listing`) which Prisma cannot express, so it lives in
/// `prisma/sql/deal-invariants.sql` and is re-applied by the `prisma:push` npm script.
model Deal {
  id                 String     @id @default(uuid())
  dealNumber         String     @unique
  /// The offer this deal was approved from. Flat column, no relation: the offer is terminal
  /// (`CONVERTED_TO_DEAL`) and the deal must not depend on it to be readable.
  offerId            String     @unique
  listingId          String
  buyerProfileId     String
  sellerProfileId    String
  dealPrice          Decimal    @db.Decimal(12, 2)
  platformCommission Decimal    @db.Decimal(12, 2)
  totalAmount        Decimal    @db.Decimal(12, 2)
  /// OQ-02: the frozen commission fraction, `0.0250` = 2.5 %. Immutable after creation.
  commissionRateSnapshot Decimal @db.Decimal(5, 4)
  /// OQ-02: the frozen flat fee, `0.00` SAR today.
  fixedCommissionSnapshot Decimal @db.Decimal(12, 2)
  /// The window the deadline was computed from, kept so `paymentDeadline - createdAt` stays
  /// verifiable after Story 8.6 makes the platform setting configurable.
  paymentWindowHoursSnapshot Int
  sellerPayoutAccountId      String
  sellerPayoutHolderName     String
  sellerPayoutBankName       String?
  /// AES-256-GCM ciphertext copied verbatim from `PayoutAccount.ibanEncrypted` (D4).
  sellerPayoutIbanEncrypted  String
  sellerPayoutIbanMasked     String
  approvedByAdminId          String
  dealReferenceCode  String     @unique
  status             DealStatus @default(AWAITING_PAYMENT_PROOF)
  paymentDeadline    DateTime
  completedAt        DateTime?
  version            Int        @default(1)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  listing       Listing     @relation(fields: [listingId], references: [id])
  buyerProfile  UserProfile @relation("BuyerDeals", fields: [buyerProfileId], references: [id])
  sellerProfile UserProfile @relation("SellerDeals", fields: [sellerProfileId], references: [id])
  payments      Payment[]
  disputes      Dispute[]
  rating        Rating?

  @@index([listingId, status])
  @@map("deals")
}

model Payment {
  id                String      @id @default(uuid())
  dealId            String
  paymentType       PaymentType
  amount            Decimal     @db.Decimal(12, 2)
  /// Story 5.2: a `String` on purpose. The vocabulary lives in `DEAL_PAYMENT_STATUS`
  /// (`packages/shared/src/constants/deal.ts`); `db push` cannot convert this column to an enum
  /// without dropping it, and `deal-invariants.sql` has no such migration.
  status            String      @default("PENDING")
  /// Story 5.2 (D3): a **`FileObject.id`**, not a URL. NFR-2 forbids persisting a presigned link
  /// (≤ 5 min); the download is minted on demand through `StorageService.getVerifiedDownloadUrl`.
  /// The column keeps this name because `db push` cannot rename without dropping its data.
  proofFileUrl      String?
  bankReferenceCode String?
  senderBankName    String?
  uploadedAt        DateTime?
  verifiedByAdminId String?
  verifiedAt        DateTime?
  rejectionReason   String?
  lockedByAdminId   String?
  lockedAt          DateTime?
  lockExpiresAt     DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Story 5.2 / AC-6, D2: exactly one row per slot. This is what makes `ensureDealPayments`
  /// idempotent — two concurrent reads cannot insert four rows, and the storage key
  /// `payments/<dealId>/<paymentId>/…` stays unique per slot.
  @@unique([dealId, paymentType])
  @@index([dealId, paymentType, status])
  @@index([lockExpiresAt])
  @@map("payments")
}

model OwnerListingRequest {
  id              String       @id @default(uuid())
  ownerProfileId  String
  propertyType    PropertyType
  cityId          String
  districtId      String
  titleDeedNumber String
  status          String       @default("PENDING")
  lockedByAdminId String?
  lockedAt        DateTime?
  lockExpiresAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  ownerProfile UserProfile @relation(fields: [ownerProfileId], references: [id])

  @@index([lockExpiresAt])
  @@map("owner_listing_requests")
}

model ContractFeePayment {
  id                String    @id @default(uuid())
  ownerContractId   String
  amount            Decimal   @db.Decimal(12, 2)
  status            String    @default("PENDING")
  proofFileUrl      String?
  bankReferenceCode String?
  senderBankName    String?
  uploadedAt        DateTime?
  verifiedByAdminId String?
  verifiedAt        DateTime?
  rejectionReason   String?
  lockedByAdminId   String?
  lockedAt          DateTime?
  lockExpiresAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownerContract OwnerContract @relation(fields: [ownerContractId], references: [id], onDelete: Cascade)

  @@index([lockExpiresAt])
  @@map("contract_fee_payments")
}

model Conversation {
  id              String    @id @default(uuid())
  dealId          String?
  buyerProfileId  String
  sellerProfileId String
  status          String    @default("ACTIVE")
  lockedByAdminId String?
  lockedAt        DateTime?
  lockExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lockExpiresAt])
  @@map("conversations")
}

model Dispute {
  id              String    @id @default(uuid())
  dealId          String
  initiatorId     String
  reason          String
  status          String    @default("OPEN")
  lockedByAdminId String?
  lockedAt        DateTime?
  lockExpiresAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([lockExpiresAt])
  @@map("disputes")
}

model Rating {
  id              String    @id @default(uuid())
  dealId          String    @unique
  raterUserId     String
  targetUserId    String
  score           Int
  comment         String?
  isHidden        Boolean   @default(false)
  hiddenByAdminId String?
  hiddenAt        DateTime?
  hiddenReason    String?
  createdAt       DateTime  @default(now())

  deal       Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  raterUser  User @relation("AuthoredRatings", fields: [raterUserId], references: [id])
  targetUser User @relation("ReceivedRatings", fields: [targetUserId], references: [id])

  @@index([targetUserId, isHidden])
  @@map("ratings")
}

model Demand {
  id              String       @id @default(uuid())
  buyerProfileId  String
  propertyType    PropertyType
  cityId          String
  districtId      String?
  // Legacy free-text geography (Story 3.6 / AD-9): retired from the API contract,
  // columns kept nullable so no data is dropped. The API never writes them.
  legacyCity      String?      @map("city")
  legacyDistricts Json?        @map("districts")
  minBudget       Decimal      @db.Decimal(12, 2)
  maxBudget       Decimal      @db.Decimal(12, 2)
  minArea         Float
  maxArea         Float
  notes           String?
  status          DemandStatus @default(ACTIVE)
  expiresAt       DateTime
  cancelledAt     DateTime?    @map("cancelled_at")
  cancelReason    String?      @map("cancel_reason")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  buyerProfile UserProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  city         City        @relation(fields: [cityId], references: [id])
  district     District?   @relation(fields: [districtId, cityId], references: [id, cityId])
  matches      DemandMatch[]
  proposals    Proposal[]

  @@index([status, cityId, propertyType])
  @@index([cityId, districtId])
  @@map("demands")
}

model DemandMatch {
  id                String   @id @default(uuid())
  demandId          String
  listingId         String
  providerProfileId String
  createdAt         DateTime @default(now())

  demand          Demand     @relation(fields: [demandId], references: [id], onDelete: Cascade)
  listing         Listing    @relation("DemandMatchListing", fields: [listingId], references: [id], onDelete: Cascade)
  providerProfile UserProfile @relation("ProviderDemandMatches", fields: [providerProfileId], references: [id])

  @@unique([demandId, listingId])
  @@index([providerProfileId, createdAt])
  @@index([demandId])
  @@map("demand_matches")
}

model Proposal {
  id                String         @id @default(uuid())
  demandId          String
  listingId         String
  providerProfileId String
  proposedPrice     Decimal        @db.Decimal(12, 2)
  status            ProposalStatus @default(PENDING_ADMIN_REVIEW)
  note              String?
  rejectReason      String?        @map("reject_reason")
  selectedAt        DateTime?      @map("selected_at")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  demand          Demand      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  listing         Listing     @relation("ProposalListing", fields: [listingId], references: [id])
  providerProfile UserProfile @relation("ProviderProposals", fields: [providerProfileId], references: [id])

  @@unique([demandId, listingId])
  @@index([status])
  @@index([demandId, status])
  @@index([providerProfileId])
  @@map("proposals")
}

model OwnerContract {
  id             String              @id @default(uuid())
  listingId      String              @unique
  ownerProfileId String
  contractFee    Decimal             @default(1000.00) @db.Decimal(12, 2)
  contractTerms  String
  signatureData  String?
  signedAt       DateTime?
  otpCode        String?
  status         OwnerContractStatus @default(DRAFT)
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  listing      Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ownerProfile UserProfile          @relation(fields: [ownerProfileId], references: [id])
  feePayments  ContractFeePayment[]

  @@map("owner_contracts")
}

model InvoiceRecord {
  id                   String   @id @default(uuid())
  invoiceNumber        String   @unique
  dealId               String?
  contractFeePaymentId String?
  sellerId             String
  buyerId              String?
  subtotalAmount       Decimal  @db.Decimal(12, 2)
  vatAmount            Decimal  @db.Decimal(12, 2)
  vatRate              Decimal  @default(0.15) @db.Decimal(4, 2)
  totalAmount          Decimal  @db.Decimal(12, 2)
  vatTreatment         String
  partyDetails         Json
  createdAt            DateTime @default(now())

  @@index([dealId])
  @@index([invoiceNumber])
  @@map("invoice_records")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  userAgent  String?
  ipAddress  String?
  activeRole UserRole @default(BUYER)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model KnownDevice {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  deviceHash String   @map("device_hash")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([userId])
  @@map("known_devices")
}

model AdminSession {
  id             String   @id @default(uuid())
  adminId        String
  token          String   @unique
  ipAddress      String?
  userAgent      String?  @map("user_agent")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorType  String
  action     String
  entityType String
  entityId   String
  payload    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model OtpVerification {
  id                String    @id @default(uuid())
  mobileNumber      String    @map("mobile_number")
  otpCode           String    @map("otp_code")
  purpose           String    @map("purpose")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3) @map("max_attempts")
  expiresAt         DateTime  @map("expires_at")
  resendAvailableAt DateTime  @map("resend_available_at")
  lockedUntil       DateTime? @map("locked_until")
  hourlyCount       Int       @default(1) @map("hourly_count")
  lastSentAt        DateTime  @default(now()) @map("last_sent_at")
  metadata          Json?     @map("metadata")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([mobileNumber, purpose])
  @@map("otp_verifications")
}
