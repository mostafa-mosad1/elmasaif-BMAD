# Database
DATABASE_URL="postgresql://elmasaif_user:elmasaif_password@localhost:5432/elmasaif_db?schema=public"

# App & Ports
PORT=4000
NODE_ENV="development"
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4000"
INTERNAL_API_URL="http://localhost:4000"

# Secrets
SESSION_SECRET="super-secret-session-key-for-elmasaif-2026-development"
ADMIN_SESSION_SECRET="super-secret-admin-session-key-for-elmasaif-development"

# Sovereign Object Storage (MinIO local / Sovereign S3 target)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="miniopassword"
STORAGE_BUCKET_PRIVATE="elmasaif-private-documents"
STORAGE_FORCE_PATH_STYLE="true"

# Legacy / S3 Fallbacks
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="miniopassword"
S3_BUCKET_PRIVATE="elmasaif-private-documents"

# OTP Provider (static or sms)
OTP_PROVIDER="static"
STATIC_OTP_CODE="123456"

# Email (Mailpit)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@elmasaif.sa"

# Malware Scanning Quarantine Hook (NFR13, AD-6)
# Engine options: mock | clamav
MALWARE_SCANNER_ENGINE="mock"
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
